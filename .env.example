PORT=4173
HOST=127.0.0.1
NODE_ENV=development
DATA_DIR=./data

# Generate with: openssl rand -base64 48
# This key protects browser/native token hashes and AES-256-GCM encrypted secrets.
APP_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
TRUST_PROXY=false
API_ACCESS_TOKEN_MINUTES=15
API_REFRESH_TOKEN_DAYS=30
API_MAX_DEVICE_SESSIONS=10

# Passkeys are bound to the public HTTPS hostname. Do not use the internal
# Proxmox address here. Example: nimbus.example.com / https://nimbus.example.com
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_NAME=Nimbus Direct
PROXMOX_REQUEST_TIMEOUT_MS=12000
RESOURCE_SYNC_SECONDS=60

# Hard safety ceiling for customer ISO uploads. Individual storage policies can
# set a lower per-file limit and customer quota.
ISO_MAX_UPLOAD_MB=8192
ISO_UPLOAD_TIMEOUT_MINUTES=120

# Optional Apple Push Notification service for the native iOS app. Convert the
# downloaded AuthKey_*.p8 file with: base64 < AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=de.liamjayden.nimbusdirect
APNS_PRIVATE_KEY_BASE64=
APNS_TIMEOUT_SECONDS=10

# Simulated infrastructure. Keep DEMO_READ_ONLY=false for an interactive local
# demo, or enable both flags for a public browsing-only demo.
ALLOW_DEMO_DATA=true
DEMO_READ_ONLY=false

# Used once, only when the database has no users. Remove the passwords after setup.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# Optional first customer and login for evaluation/demo deployments.
BOOTSTRAP_CUSTOMER_ID=acme
BOOTSTRAP_CUSTOMER_NAME=Acme Studio
BOOTSTRAP_CUSTOMER_EMAIL=customer@example.com
BOOTSTRAP_CUSTOMER_PASSWORD=replace-with-another-long-password
BOOTSTRAP_CUSTOMER_DISPLAY_NAME=Acme Operations
BOOTSTRAP_SUPPORT_EMAIL=support@example.com
BOOTSTRAP_PLAN_NAME=Managed infrastructure

# Proxmox clusters and service-account credentials are added in the encrypted
# Nimbus Direct control center. No customer pool variables exist.

# Optional internal routing overlay. Keep the certificate hostname in the API
# URL entered in Nimbus and map it only inside this container.
PROXMOX_HOSTNAME=pve.example.com
PROXMOX_INTERNAL_IP=10.0.0.10
PROXMOX_CA_FILE=./secrets/pve-root-ca.pem
NODE_EXTRA_CA_CERTS=/etc/ssl/proxmox/pve-root-ca.pem
