{
  "name": "nimbus-direct-proxmox-panel",
  "version": "1.7.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "setup": "node scripts/setup.mjs",
    "locales:check": "node scripts/validate-locales.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/validate-locales.mjs && node --check server.mjs && node --check public/app.js && node --check public/console.js && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@simplewebauthn/server": "13.3.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "qrcode": "1.5.4"
  }
}
